<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Strip any dependency-added network capability during manifest merge. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!--
        No install-time permissions yet. The blocking prototype (NOT in this skeleton)
        will need:
          - PACKAGE_USAGE_STATS (Usage Access, granted by the user in Settings)
          - SYSTEM_ALERT_WINDOW (display over other apps, only if polling is too slow)
          - FOREGROUND_SERVICE + FOREGROUND_SERVICE_SPECIAL_USE (session monitoring)
        See java/site/n4deem/dreamlock/monitoring/FocusMonitorService.kt for the plan.

        The reels monitor below is an accessibility service: no manifest permission,
        but it does nothing until the user enables it in Settings > Accessibility.
    -->

    <application
        android:name=".DreamlockApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DreamLock">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".monitoring.ReelsMonitorService"
            android:exported="false"
            android:label="@string/reels_monitor_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
